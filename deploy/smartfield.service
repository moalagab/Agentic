[Unit]
Description=Smart Field Lead Generation Agent — RevOS v6
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartfield
Group=smartfield
WorkingDirectory=/home/smartfield/app
# الربط على 127.0.0.1 فقط: nginx هو المنفذ العام الوحيد. الربط على
# 0.0.0.0 كان يكشف التطبيق مباشرةً على المنفذ 8000 متجاوزًا nginx و TLS.
ExecStart=/home/smartfield/app/.venv/bin/uvicorn channels.webhook_server:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info
Restart=always
RestartSec=5
# systemd's default crash-loop protection (5 restarts / 10s) will permanently
# give up and leave the service dead if it crashes repeatedly in a short
# window — silently, with no alert. StartLimitIntervalSec=0 disables that
# giveup so Restart=always truly means always. This does not fix whatever
# caused a crash loop, but it stops "systemd gave up" from being an
# additional, invisible failure mode on top of the real one.
StartLimitIntervalSec=0
StandardOutput=append:/home/smartfield/app/logs/app.log
StandardError=append:/home/smartfield/app/logs/app.log
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUTF8=1

[Install]
WantedBy=multi-user.target
