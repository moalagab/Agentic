# ═══════════════════════════════════════════════════════════════════════════════
# Smartfield Lead Generation Agent - Environment Variables
# متغيرات البيئة لنظام توليد العملاء المحتملين - سمارت فيلد
#
# انسخ هذا الملف إلى .env وعدّل القيم:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════


# ─── AI — Gemini (أساسي) + Claude (احتياطي) ───────────────────────────────────
# Gemini هو مزوّد الذكاء الاصطناعي الأساسي (تصنيف العملاء، توليد النصوص).
# احصل على المفتاح من: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude يُستخدم كاحتياطي (fallback) عبر Circuit Breaker عند فشل Gemini.
# احصل على المفتاح من: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Supabase (CRM الأساسي) ─────────────────────────────────────────────────────
# رابط مشروع Supabase — من: Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# مفتاح service_role (وليس anon) — يتجاوز RLS، للاستخدام من الخادم فقط
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# نظام CRM الأساسي: supabase (الافتراضي) أو hubspot أو airtable
PRIMARY_CRM=supabase


# ─── WAHA — WhatsApp HTTP API (self-hosted) ────────────────────────────────────
# القناة الأساسية لاستقبال/إرسال رسائل واتساب — بديل عن Twilio/Meta Cloud API
# رابط سيرفر WAHA (عادة يعمل محليًا على نفس الخادم)
WAHA_URL=http://localhost:3000

# مفتاح API الخاص بـ WAHA (يُضبط عند تشغيل حاوية WAHA)
WAHA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# اسم جلسة WAHA (عادة "default")
WAHA_SESSION=default


# ─── SerpAPI + Outscraper (التنقيب من Google Maps) ─────────────────────────────
# SerpAPI — نتائج بحث Google المحلية
# احصل على المفتاح من: https://serpapi.com/
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Outscraper — بيانات أعمال Google Maps التفصيلية
# احصل على المفتاح من: https://app.outscraper.com/
OUTSCRAPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Admin API Security ─────────────────────────────────────────────────────────
# ⚠️ إلزامي قبل النشر للإنتاج. بدون هذا المفتاح، endpoints الحساسة
# (حذف عميل، تعديل حقول، تشغيل backup يدوي) تكون مفتوحة لأي أحد.
# ولّد قيمة عشوائية قوية، مثال: openssl rand -hex 32
ADMIN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Telegram Bot (إشعارات المالك) ─────────────────────────────────────────────
# توكن البوت من @BotFather في تيليغرام
# الخطوات: افتح تيليغرام → ابحث عن @BotFather → /newbot → اتبع التعليمات
TELEGRAM_BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# معرفات محادثة المالك وفريق المبيعات في تيليغرام
# للحصول على chat_id: راسل @userinfobot في تيليغرام
# الصيغة: JSON array
TELEGRAM_OWNER_CHAT_IDS=["123456789", "987654321"]


# ─── Sales Team WhatsApp Notifications ────────────────────────────────────────
# أرقام واتساب لفريق المبيعات الذين سيتلقون الإشعارات
# الصيغة: JSON array من الأرقام بكود الدولة
# مثال: ["+966501234567", "+966509876543"]
SALES_TEAM_WHATSAPP=["+966501234567", "+966509876543"]


# ─── Buffer (جدولة السوشيال ميديا) ─────────────────────────────────────────────
# توكن الوصول من: https://buffer.com → Settings → Apps → Access Tokens
BUFFER_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# معرّف المنظمة في Buffer
BUFFER_ORG_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# معرّفات القنوات المتصلة بـ Buffer (اختياري، حسب المنصات المفعّلة)
BUFFER_X_CHANNEL_ID=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_INSTAGRAM_CHANNEL_ID=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_TIKTOK_CHANNEL_ID=xxxxxxxxxxxxxxxxxxxxxxxx


# ─── X (Twitter) API ────────────────────────────────────────────────────────────
# للترندات (v2 Bearer Token) والنشر المباشر (OAuth 1.0a) — كلاهما اختياري
X_BEARER_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
X_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
X_ACCESS_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Server Configuration ──────────────────────────────────────────────────────
# عنوان IP لربط الخادم (0.0.0.0 يعني جميع الواجهات)
APP_HOST=0.0.0.0

# منفذ الخادم
APP_PORT=8000

# مستوى التسجيل: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# ═══════════════════════════════════════════════════════════════════════════════
# التكاملات الاحتياطية / القديمة (Legacy / Fallback) — غير مفعّلة افتراضيًا
# ═══════════════════════════════════════════════════════════════════════════════

# ─── HubSpot CRM (بديل لـ Supabase) ────────────────────────────────────────────
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_PORTAL_ID=12345678

# ─── Airtable (بديل لـ Supabase) ───────────────────────────────────────────────
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Leads

# ─── Twilio (بديل لـ WAHA — WhatsApp Sandbox/Production) ──────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# مصادقة بديلة عبر API Key (أفضل أمنيًا من Auth Token) — اختياري
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# رقم واتساب المرسل عبر Twilio (يجب أن يبدأ بـ whatsapp:)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Content SID لقالب المتابعة المعتمد (HXxxx...)
TWILIO_FOLLOWUP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── WhatsApp Business Cloud API (بديل آخر لـ WAHA — Meta الرسمي) ─────────────
WHATSAPP_BUSINESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=smartfield_verify_2024

# ─── LinkedIn ──────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=xxxxxxxxxxxxxxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# ─── Meta Ads Webhook ──────────────────────────────────────────────────────────
META_ADS_VERIFY_TOKEN=smartfield_meta_2024

# ─── مراقبة خارجية (dead-man's switch) ──────────────────────────────────────
# رابط نبضة من healthchecks.io — يُنبّه عند *غياب* النبضة، فيكشف موت العملية
# نفسها. كل التنبيهات الأخرى تعمل داخل العملية وتموت معها.
HEARTBEAT_URL=

# ─── CORS ───────────────────────────────────────────────────────────────────
# النطاقات المسموح لها، مفصولة بفواصل. لا تستخدم "*" في الإنتاج.
CORS_ORIGINS=https://agent.smartfield.sa

# ─── توثيق الـ webhooks ─────────────────────────────────────────────────────
# سر عشوائي يُمرَّر لتيليجرام عبر setWebhook?secret_token= ويُتحقق منه في
# ترويسة X-Telegram-Bot-Api-Secret-Token. بدونه يستطيع أي شخص تزوير ضغطة
# زر "موافقة" وتجاوز بوابة الموافقة البشرية.
TELEGRAM_WEBHOOK_SECRET=

# App Secret من Meta للتحقق من توقيع X-Hub-Signature-256 على webhook واتساب
WHATSAPP_APP_SECRET=
