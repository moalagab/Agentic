# ═══════════════════════════════════════════════════════════════════════════════
# Smartfield Lead Generation Agent - Environment Variables
# متغيرات البيئة لنظام توليد العملاء المحتملين - سمارت فيلد
#
# انسخ هذا الملف إلى .env وعدّل القيم:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════


# ─── Claude / Anthropic ────────────────────────────────────────────────────────
# مفتاح API الخاص بـ Anthropic للوصول إلى نموذج Claude
# احصل عليه من: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── HubSpot CRM ───────────────────────────────────────────────────────────────
# مفتاح API الخاص بـ HubSpot (Private App Token)
# إنشاء مفتاح من: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# معرّف البوابة (Portal ID) الخاص بحساب HubSpot
# يجدها في: HubSpot → Settings → Account → Account Details
HUBSPOT_PORTAL_ID=12345678


# ─── Airtable ──────────────────────────────────────────────────────────────────
# رمز الوصول الشخصي لـ Airtable (Personal Access Token)
# إنشاء رمز من: https://airtable.com/account → Developer hub → Personal access tokens
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# معرّف القاعدة في Airtable (يبدأ بـ app)
# الحصول عليه من رابط القاعدة: airtable.com/appXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# اسم الجدول الذي يحتوي على بيانات العملاء المحتملين في Airtable
AIRTABLE_TABLE_NAME=Leads


# ─── Twilio / WhatsApp Notifications ──────────────────────────────────────────
# بيانات حساب Twilio لإرسال إشعارات واتساب لفريق المبيعات
# إنشاء حساب من: https://www.twilio.com/

# معرّف حساب Twilio (Account SID)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# رمز مصادقة Twilio (Auth Token)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# رقم واتساب المرسل عبر Twilio (يجب أن يبدأ بـ whatsapp:)
# استخدم Twilio Sandbox: whatsapp:+14155238886
# أو رقمك المعتمد: whatsapp:+966xxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
# توكن دائم للـ WhatsApp Business Cloud API من Meta
# إنشاء توكن من: Meta for Developers → WhatsApp → API Setup
WHATSAPP_BUSINESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# معرّف رقم الهاتف في WhatsApp Business (Phone Number ID)
# من: Meta for Developers → WhatsApp → API Setup → Phone Number ID
WHATSAPP_PHONE_ID=123456789012345

# رمز التحقق الخاص بـ webhook واتساب (يمكنك اختيار أي رمز)
# يُستخدم للتحقق من صحة اشتراك webhook عند ضبطه في Meta
WHATSAPP_VERIFY_TOKEN=smartfield_verify_2024


# ─── LinkedIn ──────────────────────────────────────────────────────────────────
# بيانات تطبيق LinkedIn OAuth لاستقبال نماذج العملاء
# إنشاء تطبيق من: https://developer.linkedin.com/

# معرّف تطبيق LinkedIn
LINKEDIN_CLIENT_ID=xxxxxxxxxxxxxxxxxx

# سر تطبيق LinkedIn (للتحقق من التوقيع)
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxxxx


# ─── CRM Selection ─────────────────────────────────────────────────────────────
# نظام CRM الأساسي: hubspot أو airtable
# الخيار الآخر سيكون احتياطياً (fallback)
PRIMARY_CRM=hubspot


# ─── Sales Team WhatsApp Notifications ────────────────────────────────────────
# أرقام واتساب لفريق المبيعات الذين سيتلقون الإشعارات
# الصيغة: JSON array من الأرقام بكود الدولة
# مثال: ["+966501234567", "+966509876543"]
SALES_TEAM_WHATSAPP=["+966501234567", "+966509876543"]


# ─── Server Configuration ──────────────────────────────────────────────────────
# عنوان IP لربط الخادم (0.0.0.0 يعني جميع الواجهات)
APP_HOST=0.0.0.0

# منفذ الخادم
APP_PORT=8000

# مستوى التسجيل: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# ─── Meta Ads Webhook ──────────────────────────────────────────────────────────
# رمز التحقق لـ webhook إعلانات Meta (Facebook/Instagram)
META_ADS_VERIFY_TOKEN=smartfield_meta_2024
